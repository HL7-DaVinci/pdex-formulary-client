<section class='container'>
<h2 class="text-light welcome-text">Connect to a Patient FHIR server</h2>
	<% if @client %>
		<p class="text-success text-center client-connected">
			Connected to <%= server_url -%>
		</p>
		<p class="text-success text-center client-connected">
			Patient <%= patient_id -%>
		</p>
	<%else%>
		<p class="text-danger text-center">No Connection Established</p>
	<% end %>

	<%= form_tag launch_path, method: 'get', class: 'row justify-content-center', id: 'server-form' do %>
		<div class='col-md-7'>
			<div class='mb-3'>
				<label class='form-label' for='iss_url'>FHIR Server with Patients</label>
				<%= text_field_tag :iss_url, cookies[:iss_url], class: 'form-control',
							placeholder: 'http://cpcds-ri.org/cpcds-server/fhir' %>
			</div>
			<div class='mb-3'>
				<label class='form-label' for='client_id'>ClientID</label>
				<%= text_field_tag :client_id, cookies[:client_id], class: 'form-control',
							placeholder: 'Client ID' %>
			</div>
			<div class='mb-3'>
				<label class='form-label' for='client_secret'>Client Secret</label>
				<%= text_field_tag :client_secret, cookies[:client_secret], class: 'form-control',
							placeholder: 'Client Secret' %>
			</div>
			<%= button_tag 'Connect', class: 'btn btn-primary connect', id: 'server-url' %>
		</div>
	<% end %>
</section>


