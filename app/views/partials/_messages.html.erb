<% if flash.count > 0 %>
	<section class='container messages'>
		<% flash.each do |key, value| %>
			<% if key.is_a?(String) %>
				<div data-alert class="<%= flash_class(key) %> alert alert-dismissible fade show" role="alert">
					<%= value.html_safe %>
					<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
				</div>
			<% end %>
		<% end %>
	</section>
<% end %>
