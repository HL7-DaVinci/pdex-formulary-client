
<section class='container'>
	<div class='d-flex flex-column justify-content-center mb-4'>
		<h2 class='mb-0'>
      Formulary:&nbsp;<%= sanitize(@plandata[:name]) %>
		</h2>
    <div class='card bg-transparent'>
      <div class='card-body'>
        <table class='table table-bordered'>
          <colgroup>
            <col style='width: 20%'>
            <col style='width: 20%'>
            <col style='width: 60%'>
          </colgroup>
          <thead>
            <tr>
              <th>Type</th>
              <th>Identifier</th>
              <th>Payer</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= sanitize(@plandata[:type]) %></td>
              <td><%= sanitize(@plandata[:planid]) %></td>
              <td>
                <% @plandata[:payers].each do |payer| %>
                  <%= link_to sanitize(payer[:name]), "/payerplans/#{payer[:id]}" %><br/>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
	</div>
  <%= form_tag formularies_path, method: 'get', class: 'row justify-content-center g-2' do %>
    <%= hidden_field_tag 'coverage', sanitize(@plandata[:id]) %>
    <div class='col-md-4 d-grid'>
      <%= button_tag 'View Formulary Drugs', class: 'btn btn-primary', id: 'formulary-url' %>
    </div>
  <% end %>
</section>
