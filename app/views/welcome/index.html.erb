<section class='container'>
	<h2 class="text-light welcome-text">Connect to a Formulary server</h2>
	<%= form_tag root_path, method: 'get', class: 'row justify-content-center g-2 welcome-form', id: 'server-form' do %>
		<div class='col-md-7'>
			<%= text_field_tag :server_url, nil, class: 'form-control',
						value: cookies[:server_url].presence || DEFAULT_FORMULARY_SERVER,
						placeholder: DEFAULT_FORMULARY_SERVER %>
		</div>
		<div class='col-md-2 d-grid'>
			<%= button_tag 'Connect', class: 'btn btn-primary', id: 'server-url' %>
		</div>
	<% end %>
	<div class='mt-3 mb-5'>
		<% if @client %>
			<p class="text-success client-connected mb-2">
				Connected to <%= cookies[:server_url] -%>
			</p>
			<div class='d-flex justify-content-center column-gap-4 flex-wrap'>
				<div><span class='fw-bold'><%= @count %></span> <%= link_to "Formulary Drugs", formularies_path %></div>
				<div><span class='fw-bold'><%= @cp_count %></span> <%= link_to "Formularies", coverageplans_path %></div>
				<div><span class='fw-bold'><%= @payers_count %></span> <%= link_to "Payer Insurance Plans", payerplans_path %></div>
			</div>
		<% else  %>
			<div class='text-warning guidance'>
				Not connected - please connect to a Formulary server.
			</div>
		<% end %>
	</div>
	<ul class="nav nav-tabs bg-dark" id="myTab" role="tablist">
		<li class="nav-item">
			<a class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#drug-lookup" href="#drug-lookup" role="tab" aria-controls="home" aria-selected="true">Drug Lookup</a>
		</li>
		<li class="nav-item">
			<a class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#coverage-plans" href="#coverage-plans" role="tab" aria-controls="profile" aria-selected="false">Formularies</a>
		</li>
		<li class="nav-item">
			<a class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#compare-plans" href="#compare-plans" role="tab" aria-controls="contact" aria-selected="false">Compare Formularies</a>
		</li>
	</ul>
	<div class="tab-content" id="myTabContent">
		<div class="tab-pane fade show active bg-dark" id="drug-lookup" role="tabpanel" aria-labelledby="drug-lookup-tab">
			<%= render 'drug_lookup' %>
		</div>
		<div class="tab-pane fade bg-dark" id="coverage-plans" role="tabpanel" aria-labelledby="coverage-plans-tab">
			<%= render 'coverage_plans' %>
		</div>
		<div class="tab-pane fade bg-dark" id="compare-plans" role="tabpanel" aria-labelledby="compare-plans-tab">
			<%= render 'compare_plans' %>
		</div>
	</div>
</section>

