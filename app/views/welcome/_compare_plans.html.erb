<h2 class="text-light welcome-text">Compare Formularies</h2>
<div class='mb-1'>
	<%= form_tag compare_index_path, method: 'get', class: 'row justify-content-center g-2 welcome-form', id: 'compare-form' do %>
		<div class='col-md-4'>
			<%= text_field_tag :search, nil, class: 'form-control', placeholder: 'Search by drug name' %>
		</div>
		<div class='col-md-4'>
			<%= text_field_tag :code, nil, class: 'form-control code-input', placeholder: 'RxNorm codes seperated by comma'%>
		</div>
		<div class='col-md-3 d-grid'>
			<%= button_tag 'Compare Formularies', class: 'btn btn-primary', id: 'compare-url', disabled: @client.nil? %>
		</div>
	<% end %>
</div>
<p class='text-info guidance ms-auto me-auto mb-5'>
	Please specify part of a drugname and/or a list of RxNorm codes.
	Pressing "Lookup" will display the intersection of defined options.
</p>
